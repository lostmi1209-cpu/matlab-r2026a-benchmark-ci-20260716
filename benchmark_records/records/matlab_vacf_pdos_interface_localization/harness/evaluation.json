{
  "schema_version": "1.0",
  "record_id": "matlab_vacf_pdos_interface_localization",
  "purpose": "evaluate_submission",
  "status": "ready_after_ground_truth_generation",
  "execution_environment": {
    "matlab_release": "R2026a",
    "required_products": [
      "MATLAB"
    ],
    "third_party_dependencies": []
  },
  "entrypoint": "harness/evaluate_submission.m",
  "function_signature": "evaluate_submission(submission_dir, ground_truth_dir, report_path)",
  "example_command": "matlab -batch \"addpath('harness'); report=evaluate_submission('submission','ground_truth/output','evaluation/grade.json'); disp(report)\"",
  "submission_files": [
    "vacf.csv",
    "pdos.csv",
    "phonon_summary.json"
  ],
  "ground_truth_files": [
    "vacf.csv",
    "pdos.csv",
    "phonon_summary.json"
  ],
  "report_schema": {
    "record_id": "string",
    "score": "number in [0,100]",
    "max_score": 100,
    "passed": "boolean",
    "details": "step-level earned points and messages"
  },
  "self_check": "Using ground_truth/output as both submission_dir and ground_truth_dir must return 100 points."
}
